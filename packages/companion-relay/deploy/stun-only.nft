# Additive, dedicated table. NEVER flush the host ruleset. Review with nft -c
# before activation; installing this table does not bypass other firewall rules.
table inet lolicode_stun {
    set sources4 { type ipv4_addr; flags dynamic,timeout; timeout 60s; size 4096; }
    set sources6 { type ipv6_addr; flags dynamic,timeout; timeout 60s; size 4096; }
    chain input {
        type filter hook input priority -10; policy accept;
        udp dport 3478 jump binding_input
        tcp dport { 3478, 5349 } counter drop
        udp dport { 3479, 5349, 5350 } counter drop
    }
    chain binding_input {
        # UDP header 8 bytes, STUN type Binding Request 0x0001, RFC5389 cookie.
        udp length 28-1024 @th,64,16 0x0001 @th,96,32 0x2112a442 jump bounded_input
        counter drop
    }
    chain bounded_input {
        limit rate over 100/second burst 100 packets counter drop
        meta nfproto ipv4 update @sources4 { ip saddr limit rate 5/second burst 10 packets } counter accept
        meta nfproto ipv6 update @sources6 { ip6 saddr limit rate 5/second burst 10 packets } counter accept
        # Full address tables and exhausted per-address buckets fail closed.
        counter drop
    }
    chain output {
        type filter hook output priority -10; policy accept;
        udp sport 3478 jump binding_output
    }
    chain binding_output {
        limit rate over 100/second burst 100 packets counter drop
        # Only bounded Binding Success responses; byte limiter also caps bursts.
        udp length 28-256 @th,64,16 0x0101 @th,96,32 0x2112a442 limit rate 16 kbytes/second burst 32 kbytes counter accept
        counter drop
    }
}
