{
  "name": "lolicode",
  "version": "1.1.2",
  "description": "LoliCode desktop coding agent with shared model channels",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev/lolicode-development.mjs dev",
    "build": "pnpm run build:dev",
    "build:dev": "node scripts/dev/lolicode-development.mjs build",
    "build:release": "node scripts/dev/lolicode-development.mjs release",
    "dev:register": "node scripts/dev/lolicode-development.mjs register",
    "dev:unregister": "node scripts/dev/lolicode-development.mjs unregister",
    "tauri": "tauri",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "prepare:harness-runtime": "node scripts/build/prepare-lolicode-harness-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,json}\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "prepare:agent-assets": "node scripts/build/prepare-agent-assets.mjs"
  },
  "keywords": [],
