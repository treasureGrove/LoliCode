{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@deepseek-ai/dsh-api-session-controller/types": [
        "packages/lolicode-harness-runtime/node_modules/@deepseek-ai/dsh-api-session-controller/lib/types/types.d.ts"
      ],
      "@deepseek-ai/dsh-llm/assistant-stream": [
        "packages/lolicode-harness-runtime/node_modules/@deepseek-ai/dsh-llm/lib/types/assistant-stream.d.ts"
      ]
    },
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*", "tests/**/*"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
